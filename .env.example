NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Exact application origin, without path; use the appropriate value per environment.
APP_ORIGIN=http://localhost:3000
# Cloudflare Turnstile login: only enabled if BOTH keys are set.
# Secret is server-only, NEVER NEXT_PUBLIC_. Confirm the expected hostname exactly.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=avaloncoreagency.com
# Keep disabled until password authentication is explicitly approved.
AUTH_PASSWORD_LOGIN_ENABLED=true # Legacy: password login is now always enabled
# Server-only random secret (at least 32 characters) to sign short-lived email-flow proofs.
AUTH_FLOW_SECRET=
# Avalon AI Engine — SERVER-ONLY (never NEXT_PUBLIC_*). Free tiers only; the live worker reads these from GitHub Actions secrets.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENROUTER_API_KEY=
# Oracle Cloud (prepared, not operational): OpenAI-compatible URL of a local model on an Always Free instance.
ORACLE_AI_BASE_URL=
ORACLE_AI_VERIFIED=false
