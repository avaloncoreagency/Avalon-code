{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "at",
    "github",
    "vercel",
    "supabase",
    "findings",
    "events",
    "checkpoint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "github": {
      "type": "object",
      "required": [
        "status",
        "checked_at",
        "verified_at",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "data": {
          "type": [
            "object",
            "array",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "vercel": {
      "type": "object",
      "required": [
        "status",
        "checked_at",
        "verified_at",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "data": {
          "type": [
            "object",
            "array",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "supabase": {
      "type": "object",
      "required": [
        "status",
        "checked_at",
        "verified_at",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "STALE",
            "UNKNOWN"
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "data": {
          "type": [
            "object",
            "array",
            "null"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "claim",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "claim": {
            "enum": [
              "VERIFIED",
              "INFERRED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "github_since"
      ],
      "additionalProperties": false,
      "properties": {
        "github_since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
