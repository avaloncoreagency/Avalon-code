{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item_id",
    "project",
    "module",
    "original_owner",
    "resuming_owner",
    "repository",
    "branch",
    "base_sha",
    "head_sha",
    "pull_request",
    "status",
    "last_verified_at",
    "verification_sources",
    "completed_work",
    "pending_work",
    "blockers",
    "changed_files",
    "test_results",
    "deployment_status",
    "database_dependencies",
    "next_action",
    "safety_warnings",
    "claims",
    "required_commands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "original_owner": {
      "enum": [
        "miguel",
        "samuel"
      ]
    },
    "resuming_owner": {
      "enum": [
        "miguel",
        "samuel"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "pull_request": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "Draft",
        "Ready",
        "Accepted",
        "In progress",
        "Completed",
        "Superseded",
        "Blocked"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_results": {
      "type": "string",
      "minLength": 1
    },
    "deployment_status": {
      "type": "string",
      "minLength": 1
    },
    "database_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "safety_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "VERIFIED",
              "REPORTED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
