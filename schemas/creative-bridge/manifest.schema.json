{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_ref",
    "owner",
    "agent",
    "branch",
    "head_sha",
    "ci",
    "next_action",
    "delivery",
    "assets",
    "events",
    "receipt",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^github:avaloncoreagency/Avalon-code#[1-9][0-9]*$"
    },
    "project_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "owner": {
      "enum": [
        "miguel",
        "samuel"
      ]
    },
    "agent": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "ci": {
      "enum": [
        "UNKNOWN",
        "PENDING",
        "PASSED",
        "FAILED"
      ]
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "delivery": {
      "type": [
        "object",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "job_ref",
          "storage_ref",
          "sha256",
          "reduced_motion_ref",
          "kind",
          "alt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "enum": [
              "pending",
              "generating",
              "ready",
              "failed",
              "cancelled"
            ]
          },
          "job_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "storage_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:supabase-storage://|sha256:)[a-zA-Z0-9_./:-]+$",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reduced_motion_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:supabase-storage://|sha256:)[a-zA-Z0-9_./:-]+$",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "image",
              "video"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 500
          },
          "public_path": {
            "type": "string",
            "pattern": "^/creative-bridge/[a-f0-9]{64}\\.(png|webp|jpg|mp4)$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "lead_id"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "lead_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "agent",
          "action"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "agent": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pull_request": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https://github\\.com/avaloncoreagency/Avalon-code/pull/[1-9][0-9]*$"
            }
          ]
        },
        "ci_url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https://github\\.com/avaloncoreagency/Avalon-code/actions/runs/[1-9][0-9]*$"
            }
          ]
        },
        "preview_url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
            }
          ]
        },
        "demo_url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
            }
          ]
        },
        "production_url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
